# Скопируйте в .env и поменяйте значения:  cp .env.example .env
# Значения со знаком $ (BCrypt-хэш) обязательно в одинарных кавычках.

# ---- Backend (Java) ----
# Секрет подписи JWT: не короче 32 байт. ОБЯЗАТЕЛЬНО замените на свой.
JWT_SECRET=change-me-to-a-long-random-string-of-at-least-32-bytes
# Администратор, которого создаёт миграция Flyway при первом запуске.
# Пример ниже: логин adminuser, пароль Admin12345 (замените!).
# Свой BCrypt-хэш (префикс $2a) можно получить так:
#   pip install bcrypt
#   python3 -c "import bcrypt; print(bcrypt.hashpw(b'ВашПароль', bcrypt.gensalt(10, prefix=b'2a')).decode())"
ADMIN_USERNAME=adminuser
ADMIN_EMAIL=admin@example.com
ADMIN_FULL_NAME=Администратор Системы
ADMIN_ROLE=ADMIN
ADMIN_PASSWORD='$2a$10$0DQe/y4anWMIgbSPAW/YgOaXdBBd/q.IrP8ELvZBMiOYUcFEc9V2m'

# ---- Где лежат исходники backend (папка с его Dockerfile) ----
BACKEND_CONTEXT=../backend

# ---- Порт, на котором frontend доступен на вашем компьютере ----
FRONTEND_PORT=3000
